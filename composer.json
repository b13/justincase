{
  "name": "b13/justincase",
  "type": "typo3-cms-extension",
  "description": "With incoming URLs, it does not matter if they are upper/lowercase, they just work.",
  "license": "GPL-2.0-or-later",
  "require": {
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-frontend": "^13.4 || ^14.0"
  },
  "replace": {
    "typo3-ter/justincase": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "justincase"
    }
  },
  "autoload": {
    "psr-4": {
      "B13\\JustInCase\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "B13\\JustInCase\\Tests\\": "Tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.0",
    "saschaegerer/phpstan-typo3": "^3.0",
    "typo3/coding-standards": "^0.5.5",
    "typo3/tailor": "^1.1 || ^2.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "scripts": {
    "php:cs": "@composer exec 'php-cs-fixer fix --config=php-cs-fixer.php'",
    "php:phpstan": "@composer exec 'phpstan analyse -c phpstan.neon'",
    "php:unit": "@composer exec 'phpunit -c Build/phpunit/UnitTests.xml'"
  }
}
